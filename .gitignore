# Gradle wrapper
!gradle/wrapper/gradle-wrapper.jar

# Secrets
*.jks
*.keystore
# Motif volontairement large : local.properties contient les mots de passe du
# keystore. Les fichiers de configuration Gradle partagés sont réintégrés juste
# en dessous — sans eux, le build n'est pas reproductible hors de ce poste.
*.properties
!gradle.properties
!gradle/wrapper/gradle-wrapper.properties

# GrepAI
.grepai/

# Claude Code — local/per-developer config only; shared config (settings.json,
# agents/, commands/, skills/) stays versioned.
.claude/settings.local.json
.claude/*.local.md

# Cache Python des scripts
__pycache__/
